input {
  keyboard {
      xkb {
      //numlock
      }
  }
  touchpad {
      // drag-lock
      natural-scroll
      // accel-speed 0.2
      // accel-profile "flat"
      scroll-method "two-finger"
  }
  mouse {
      // off
      // natural-scroll
      // accel-speed 0.2
      // accel-profile "flat"
      // scroll-method "no-scroll"
  }
  /-trackpoint {
  }
  warp-mouse-to-focus
  focus-follows-mouse 
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

layout {
  gaps 8
  background-color "transparent"
  center-focused-column "on-overflow"
  always-center-single-column
  default-column-display "tabbed"
  tab-indicator {
      hide-when-single-tab
      width 4
      gap -12
      gaps-between-tabs 4
      corner-radius 25
      length total-proportion=0.35
      position "left"
      place-within-column
  }
  preset-column-widths {
      proportion 0.15
      proportion 0.35
      proportion 0.5
      proportion 0.65
      proportion 0.85
      proportion 1.0
  }
  // preset-window-heights { }
  default-column-width { proportion 0.85; } 
  border {
      width 2
  }
  focus-ring {
      off
  }
  shadow { 
    off
    softness 8
    spread 0
    offset x=0 y=0
    color "#000000"
  }
  struts {
      left 6
      right 6
      top 4
      bottom 4
  }
}

/-layer-rule {
  match namespace="dms:blurwallpaper"
  place-within-backdrop true
}
layer-rule {
  match namespace="^quickshell$"
  place-within-backdrop true
}
layer-rule {
  match namespace="^notifications$"
  block-out-from "screen-capture"
}

//spawn-at-startup ""
// spawn-sh-at-startup ""

hotkey-overlay {
  skip-at-startup
}


window-rule {
  geometry-corner-radius 8
  clip-to-geometry true
  tiled-state true
  draw-border-with-background false
}
window-rule {
  match app-id=r#"org.quickshell$"#
  open-floating true
}
window-rule {
  match title="^Picture-in-Picture$"
  open-floating true
  block-out-from "screen-capture"
  default-floating-position x=15 y=15 relative-to="bottom-left"
  default-column-width { proportion 0.35; }
  border {
    off 
  }
  shadow {
    off
    softness 20
    spread 3
    offset x=0 y=0
    color "#000000"
  }
}

window-rule {
  match app-id="showmethekey-gtk"
  open-floating true
  default-floating-position x=15 y=15 relative-to="bottom"
  min-height 100
  max-height 100
}

window-rule {
  match app-id="osu!" 
  match app-id="osu!lazer" 
  default-column-width { proportion 1.0; }
}

window-rule {
  match is-active=false
  exclude title="^Picture-in-Picture$"
  exclude app-id="showmethekey-gtk"
  opacity 0.8
}

overview {
  workspace-shadow {
      off
  }
}

gestures {
  hot-corners {
      off
  }
}
environment {
  QT_QPA_PLATFORMTHEME "gtk3"
  QT_QPA_PLATFORMTHEME_QT6 "gtk3"
}

include "dms/colors.kdl"
//include "dms/layout.kdl"
include "dms/alttab.kdl"
include "dms/binds.kdl"
//include "dms/wpblur.kdl"


