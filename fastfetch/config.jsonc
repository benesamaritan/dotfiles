{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "position": "left"
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[90m┌─Hardware────────────────────────────────────────────────┐"
    },
    {
      "type": "host",
      "key": "󰌢 PC"
    },
    {
      "type": "cpu",
      "showPeCoreCount": false,
      "temp": false,
      "key": "└─├─󰻠"
    },
    {
      "type": "memory",
      "key": "  ├─󰑭"
    },
    {
      "type": "localip",
      "showSpeed": true,
      "key": "  └─󰩟"
    },
    {
      "type": "wifi",
      "key": "    └─"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└─────────────────────────────────────────────────────────┘"
    },
    // "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌─GNU+Linux (Actually)────────────────────────────────────┐"
    },
    {
      "type": "os",
      "key": "{icon}"
    },
    {
      "type": "kernel",
      "key": "└─├─"
    },
    {
      "type": "packages",
      "key": "  ├─󰏖"
    },
    {
      "type": "lm",
      "key": "  ├─󰧨"
    },
    {
      "type": "de",
      "key": "  ├─"
    },
    {
      "type": "wm",
      "key": "  ├─"
    },
    {
      "type": "wallpaper",
      "key": "  ├─󰸉"
    },
    {
      "type": "theme",
      "key": "  ├─󰉼"
    },
    {
      "type": "icons",
      "key": "  ├─󰀻"
    },
    {
      "type": "terminal",
      "key": "  └─"
    },
    {
      "type": "terminalfont",
      "key": "    ├─"
    },
    {
      "type": "shell",
      "key": "    └─"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└─────────────────────────────────────────────────────────┘"
    },
    // "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌─Uptime / Age────────────────────────────────────────────┐"
    },
    {
      "type": "command",
      "key": "  󰅐 OS Age ",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "  󰅐 Uptime "
    },
    {
      "type": "custom",
      "format": "\u001b[90m└─────────────────────────────────────────────────────────┘"
    }
  ]
}